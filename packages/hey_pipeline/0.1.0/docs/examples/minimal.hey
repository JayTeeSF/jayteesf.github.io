# hey_pipeline is driven from the shell, not imported as a library; this example
# exists because the packager requires a runnable docs example, and it shows the
# one thing the module surface does expose: the package version.
import 'stdlib:Minispec'
import '../../main.hey'

spec 'hey_pipeline version'
  expect stdout "hey_pipeline version: 1 passed, 0 failed\n"
end

program
  let s = Minispec.suite('hey_pipeline version')
  set s = Minispec.to_equal(s, 'reports a version', type(HeyPipelineInfo.version()), 'string')
  let done = Minispec.report(s)
end
