# Build Stripe Checkout and Billing Portal session parameters.
# No network access: these are the request shapes only.
#
# Run from the package root: heyc docs/examples/basic.hey
import '../../form.hey'
import '../../checkout.hey'
import '../../portal.hey'

program
  let checkout = HeyStripeCheckout.subscription_session_params('price_123', 'https://app.example/success', 'https://app.example/cancel', 'a@example.com', 'org_123')
  says HeyStripeCheckout.endpoint()
  says checkout.mode
  says HeyStripeForm.encode(checkout)

  let portal = HeyStripePortal.session_params('cus_123', 'https://app.example/settings')
  says portal.customer
end
