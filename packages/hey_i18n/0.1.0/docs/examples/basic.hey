import '../../src/I18n.hey'

program
  let catalog = {
    en: {app_name: 'Demo App', greeting: 'Hello {name}'},
    es: {greeting: 'Hola {name}'},
  }
  let chain = I18n.chain('es-MX', 'en')
  says I18n.format(catalog, chain, 'greeting', {name: 'Ada'})
  says I18n.t(catalog, chain, 'app_name')

  let plural_catalog = {
    pl: {file_count: {one: '1 plik', few: '{count} pliki', many: '{count} plikow'}},
  }
  says I18n.plural(plural_catalog, I18n.chain('pl', 'en'), 'file_count', 5, {count: 5})

  let body = 'body { color: red; } <h1>@@app_name@@</h1>'
  says I18n.render_body(body, catalog, chain, '@@', '@@')
end
