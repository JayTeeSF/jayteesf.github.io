# Runs anywhere: names the backend and says whether io_uring can run here,
# and if not, why (the same named error open() would give).
import 'stdlib:Result'
import '../../io_uring.hey'

program
  says "hey_io_uring #{IoUring.version()} backend #{IoUring.backend()}"
  let here = IoUring.available({})
  if here.ok
    says "available: kernel #{here.value.kernel}, ring setup #{here.value.setup}"
  else
    says "not here: #{Result.code(here)}"
  end
end
