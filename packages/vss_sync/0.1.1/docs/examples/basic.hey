# The pure parts of the VSS v3 protocol: identity and route construction.
#
# Everything here is a pure function of its arguments -- no transport, no
# storage, no keys -- which is the whole point of the package: several
# independent clients can agree on the same bytes without agreeing on
# anything else. Run it with:  heyc docs/examples/basic.hey --run
import '../../src/main.hey'

program
  # Protocol and format identities are what every client must match exactly.
  says VssSync.protocol()
  says VssSync.revision_format()
  says VssSync.recovery_format()

  # Routes are constructed, never hand-assembled by callers, so a typo
  # cannot become a divergent path that only one client agrees with.
  says VssSync.create_revision_path('vault_demo', 'item_demo')
  says VssSync.field_path('vault_demo', 'item_demo', 'title')
  says VssSync.recovery_path('vault_demo')
end
