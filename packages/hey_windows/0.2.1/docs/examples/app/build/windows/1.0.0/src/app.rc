#include <winver.h>
hey_windows_app_icon ICON "app.ico"
1 24 "app.exe.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Example Publisher"
      VALUE "FileDescription", "Hey Windows Example"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "HeyWindowsExample"
      VALUE "OriginalFilename", "HeyWindowsExample.exe"
      VALUE "ProductName", "Hey Windows Example"
      VALUE "ProductVersion", "1.0.0"
      VALUE "LegalCopyright", "Copyright Example Publisher"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
