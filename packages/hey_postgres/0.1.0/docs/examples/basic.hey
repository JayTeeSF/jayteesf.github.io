# Pure documentation example (no live database required): shows how to describe
# a connection and inspect capabilities. See specs/native_spec.hey and
# docs/GETTING_STARTED.md for a live end-to-end run.
import '../../main.hey'

program
  says HeyPostgres.version()
  says Postgres.capabilities().driver
  # A conninfo string is built from safe keyword/value pairs — parameters are
  # always sent separately, never concatenated into SQL.
  says Postgres.conninfo({host: '127.0.0.1', port: 5432, dbname: 'mmeoww', user: 'app', sslmode: 'require'})
end
