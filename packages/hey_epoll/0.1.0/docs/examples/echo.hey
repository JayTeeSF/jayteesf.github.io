# One loop, one client, one request and reply; prints "echo: hello".
import 'stdlib:Bytes'
import 'stdlib:Io'
import 'stdlib:Net'
import '../../epoll.hey'

program
  let loop = Epoll.open('127.0.0.1', 0, {}).value
  let client = Net.connect('127.0.0.1', loop.port, {}).value
  client.write_all('hello')
  let ready = Epoll.wait(loop, 2000)
  let id = Epoll.next(loop)
  let got = Epoll.data(loop, id)
  let sent = Epoll.send(loop, id, len(got), 'echo: ' + got, true)
  let reply = client.read_exact(11)
  says Bytes.decode(reply.value.data, 'utf-8')
  let closed = Epoll.close(loop)
end
