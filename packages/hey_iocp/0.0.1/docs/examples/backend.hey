# Runs anywhere: names the backend and shows what open() says on this system.
# (On Windows it would open a loop; see echo.hey. Unverified: see README.)
import 'stdlib:Result'
import '../../iocp.hey'

program
  says "hey_iocp #{Iocp.version()} backend #{Iocp.backend()}"
  let opened = Iocp.open('127.0.0.1', 0, {})
  if opened.ok
    says "opened a loop on port #{opened.value.port}"
    let closed = Iocp.close(opened.value)
  else
    says "not here: #{Result.code(opened)}"
  end
end
