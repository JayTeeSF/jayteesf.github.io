#!/usr/bin/env hey

import 'stdlib:Cli'
import 'stdlib:Collections'
import 'stdlib:Env'
import 'stdlib:Files'
import 'stdlib:Time'
import 'stdlib:Text'

module PackagesIndex
  fn new(packages_dir, generated_at, workers)
    return {
      packages_dir: packages_dir,
      output_path: Files.join(packages_dir, 'index.html'),
      generated_at: generated_at,
      workers: workers
    }
  end

  # --workers N, or PACKAGES_INDEX_WORKERS. Defaults to 4, which measured
  # fastest on a 14-package tree; 1 is the serial path.
  private fn worker_count(args)
    # The flag wins, and is checked first so the common case never pays
    # for an environment lookup (Env.default measured ~5 ms here).
    let requested = ''
    let index = 0

    while index < args.length
      if args[index] == '--workers' and index + 1 < args.length
        set requested = args[index + 1]
      end
      set index = index + 1
    end

    if requested == ''
      set requested = Env.default('PACKAGES_INDEX_WORKERS', '')
    end

    # Nothing supplied: take the default without validating it. This is
    # not micro-optimisation — Text.int_token? is a delegated call, and
    # the first delegated call in a process costs ~5.8 ms (probe:
    # war-room bench/probes/cli-startup-call-cost.hey). Paying that to
    # check a literal we wrote ourselves cost 20% of total runtime.
    if requested == ''
      return 4
    end

    if !Text.int_token?(requested)
      fail "--workers expects a positive integer, got #{requested}"
    end

    let count = Text.parse_int(requested)
    if count < 1
      fail '--workers must be at least 1'
    end

    return count
  end

  fn generate(index)
    PackagesIndex.validate_packages_dir!(index)
    Files.write_text(index.output_path, PackagesIndex.render_page(index))
    says "Generated #{index.output_path}"
  end

  private fn validate_packages_dir!(index)
    if Files.directory?(index.packages_dir)
      return
    end

    fail "Packages directory does not exist: #{index.packages_dir}"
  end

  private fn digit?(character)
    return character >= '0' and character <= '9'
  end

  private fn digit_run(value, start)
    let finish = start

    while finish < value.length and PackagesIndex.digit?(slice(value, finish, 1))
      set finish = finish + 1
    end

    return {
      value: slice(value, start, finish - start),
      next: finish
    }
  end

  private fn trim_leading_zeroes(value)
    let index = 0

    while index + 1 < value.length and slice(value, index, 1) == '0'
      set index = index + 1
    end

    return slice(value, index, value.length - index)
  end

  private fn compare_digit_runs(left, right)
    let normalized_left = PackagesIndex.trim_leading_zeroes(left)
    let normalized_right = PackagesIndex.trim_leading_zeroes(right)

    let comparison = Collections.compare(
      normalized_left.length,
      normalized_right.length
    )
    if comparison != 0
      return comparison
    end

    set comparison = Collections.compare(normalized_left, normalized_right)
    if comparison != 0
      return comparison
    end

    return Collections.compare(left.length, right.length)
  end

  fn compare_paths(left, right)
    let folded_left = Text.lower(left)
    let folded_right = Text.lower(right)
    let left_index = 0
    let right_index = 0

    while left_index < folded_left.length and right_index < folded_right.length
      let left_character = slice(folded_left, left_index, 1)
      let right_character = slice(folded_right, right_index, 1)

      if PackagesIndex.digit?(left_character) and PackagesIndex.digit?(right_character)
        let left_run = PackagesIndex.digit_run(folded_left, left_index)
        let right_run = PackagesIndex.digit_run(folded_right, right_index)
        let comparison = PackagesIndex.compare_digit_runs(
          left_run.value,
          right_run.value
        )

        if comparison != 0
          return comparison
        end

        set left_index = left_run.next
        set right_index = right_run.next
      else
        let comparison = Collections.compare(left_character, right_character)
        if comparison != 0
          return comparison
        end

        set left_index = left_index + 1
        set right_index = right_index + 1
      end
    end

    let comparison = Collections.compare(
      folded_left.length,
      folded_right.length
    )
    if comparison != 0
      return comparison
    end

    return Collections.compare(left, right)
  end

  private fn sorted_unique(paths)
    return paths.uniq.sort(PackagesIndex.compare_paths)
  end

  private fn package_directories(index)
    let directories = []

    for path in Files.entries(index.packages_dir)
      if Files.directory?(path) and !Text.starts_with?(Files.basename(path), '.')
        set directories = [...directories, path]
      end
    end

    return directories.sort(PackagesIndex.compare_paths)
  end

  private fn package_files(package_dir)
    return Files.files(package_dir, '')
  end

  private fn docs_directories(package_dir, files)
    let directories = []
    let package_docs = Files.join(package_dir, 'docs')

    if Files.directory?(package_docs)
      set directories = [...directories, package_docs]
    end

    for version_dir in Files.entries(package_dir)
      if Files.directory?(version_dir)
        let version_docs = Files.join(version_dir, 'docs')
        if Files.directory?(version_docs)
          set directories = [...directories, version_docs]
        end
      end
    end

    for path in files
      let current = Files.dirname(path)

      while current != package_dir
        if Files.basename(current) == 'docs'
          set directories = [...directories, current]
          set current = package_dir
        else
          let parent = Files.dirname(current)
          if parent == current
            set current = package_dir
          else
            set current = parent
          end
        end
      end
    end

    return PackagesIndex.sorted_unique(directories)
  end

  private fn linkable_files(files)
    let linkable = []

    for path in files
      let lower_path = Text.lower(path)
      if Text.ends_with?(lower_path, '.md') or Text.ends_with?(lower_path, '.html')
        set linkable = [...linkable, path]
      end
    end

    return PackagesIndex.sorted_unique(linkable)
  end

  private fn relative_path(path, root)
    if path == root
      return ''
    end

    let prefix = root
    if !Text.ends_with?(prefix, '/')
      set prefix = prefix + '/'
    end

    if Text.starts_with?(path, prefix)
      return Text.strip_prefix(path, prefix)
    end

    let parent = Files.dirname(path)
    if parent == path
      fail "path is not inside root: #{path} root=#{root}"
    end

    let leaf = Files.basename(path)
    let parent_relative = PackagesIndex.relative_path(parent, root)
    if parent_relative == ''
      return leaf
    end

    return Files.join(parent_relative, leaf)
  end

  private fn html(value)
    let escaped = Text.replace_all(value, '&', '&amp;')
    set escaped = Text.replace_all(escaped, '<', '&lt;')
    set escaped = Text.replace_all(escaped, '>', '&gt;')
    set escaped = Text.replace_all(escaped, '"', '&quot;')
    set escaped = Text.replace_all(escaped, "'", '&#39;')
    return escaped
  end

  private fn url_path(value)
    let encoded = Text.replace_all(value, '%', '%25')
    set encoded = Text.replace_all(encoded, ' ', '%20')
    set encoded = Text.replace_all(encoded, '#', '%23')
    set encoded = Text.replace_all(encoded, '?', '%3F')
    set encoded = Text.replace_all(encoded, '"', '%22')
    set encoded = Text.replace_all(encoded, "'", '%27')
    set encoded = Text.replace_all(encoded, '<', '%3C')
    set encoded = Text.replace_all(encoded, '>', '%3E')
    return encoded
  end

  private fn directory_link(packages_dir, path, package_dir)
    let href = PackagesIndex.url_path(
      PackagesIndex.relative_path(path, packages_dir)
    ) + '/'
    let label = PackagesIndex.relative_path(path, package_dir) + '/'

    return %qq(        <li class="directory"><a href="#{PackagesIndex.html(href)}">#{PackagesIndex.html(label)}</a></li>)
  end

  private fn file_link(packages_dir, path, package_dir)
    let href = PackagesIndex.url_path(
      PackagesIndex.relative_path(path, packages_dir)
    )
    let label = PackagesIndex.relative_path(path, package_dir)

    return %qq(        <li><a href="#{PackagesIndex.html(href)}">#{PackagesIndex.html(label)}</a></li>)
  end

  private fn documentation_section(packages_dir, docs, package_dir)
    if docs.empty?
      return ['      <p class="empty">No docs directories found.</p>']
    end

    let lines = [
      '      <h3>Documentation directories</h3>',
      '      <ul>'
    ]

    for path in docs
      set lines = [
        ...lines,
        PackagesIndex.directory_link(packages_dir, path, package_dir)
      ]
    end

    return [...lines, '      </ul>']
  end

  private fn files_section(packages_dir, files, package_dir)
    if files.empty?
      return ['      <p class="empty">No Markdown or HTML files found.</p>']
    end

    let lines = [
      '      <h3>Markdown and HTML files</h3>',
      '      <ul>'
    ]

    for path in files
      set lines = [
        ...lines,
        PackagesIndex.file_link(packages_dir, path, package_dir)
      ]
    end

    return [...lines, '      </ul>']
  end

  private fn package_section(task)
    let packages_dir = task.packages_dir
    let package_dir = task.package_dir
    let files = PackagesIndex.package_files(package_dir)
    let docs = PackagesIndex.docs_directories(package_dir, files)
    let linkable = PackagesIndex.linkable_files(files)
    let package_name = Files.basename(package_dir)
    let package_href = PackagesIndex.url_path(
      PackagesIndex.relative_path(package_dir, packages_dir)
    ) + '/'

    let lines = [
      '    <section class="package">',
      %qq(      <h2><a href="#{PackagesIndex.html(package_href)}">#{PackagesIndex.html(package_name)}</a></h2>),
      ...PackagesIndex.documentation_section(packages_dir, docs, package_dir),
      ...PackagesIndex.files_section(packages_dir, linkable, package_dir),
      '    </section>'
    ]

    return Text.join(lines, "\n")
  end

  # Each task is self-contained so it can be rendered on any worker.
  private fn package_tasks(index, package_dirs)
    let tasks = []

    for package_dir in package_dirs
      set tasks = [
        ...tasks,
        { packages_dir: index.packages_dir, package_dir: package_dir }
      ]
    end

    return tasks
  end

  private fn render_page(index)
    let package_dirs = PackagesIndex.package_directories(index)
    let sections = []

    if package_dirs.empty?
      set sections = ['    <p class="empty">No packages found.</p>']
    else
      let tasks = PackagesIndex.package_tasks(index, package_dirs)

      if index.workers == 1
        for task in tasks
          set sections = [...sections, PackagesIndex.package_section(task)]
        end
      else
        set sections = tasks
          .map(PackagesIndex.package_section, workers: index.workers)
          .collect()
      end
    end

    let lines = [
      '<!doctype html>',
      '<html lang="en">',
      '<head>',
      '  <meta charset="utf-8">',
      '  <meta name="viewport" content="width=device-width, initial-scale=1">',
      '  <title>Hey Packages</title>',
      '  <style>',
      '    :root {',
      '      color-scheme: light dark;',
      '      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;',
      '      line-height: 1.5;',
      '    }',
      '',
      '    body {',
      '      max-width: 960px;',
      '      margin: 0 auto;',
      '      padding: 2rem 1rem 4rem;',
      '    }',
      '',
      '    header {',
      '      margin-bottom: 2rem;',
      '    }',
      '',
      '    .package {',
      '      margin: 1.5rem 0;',
      '      padding: 1rem 1.25rem;',
      '      border: 1px solid rgba(128,128,128,0.35);',
      '      border-radius: 0.5rem;',
      '    }',
      '',
      '    h2 {',
      '      margin-top: 0;',
      '    }',
      '',
      '    h3 {',
      '      margin-bottom: 0.25rem;',
      '      font-size: 1rem;',
      '    }',
      '',
      '    ul {',
      '      margin-top: 0.25rem;',
      '    }',
      '',
      '    li {',
      '      margin: 0.2rem 0;',
      '    }',
      '',
      '    .directory a {',
      '      font-weight: 600;',
      '    }',
      '',
      '    .empty,',
      '    .generated-at {',
      '      opacity: 0.7;',
      '    }',
      '',
      '    code {',
      '      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;',
      '    }',
      '  </style>',
      '</head>',
      '<body>',
      '  <header>',
      '    <h1>Hey Packages</h1>',
      '    <p>Documentation and browsable package files.</p>',
      '  </header>',
      '',
      '  <main>',
      ...sections,
      '  </main>',
      '',
      '  <footer>',
      '    <p class="generated-at">',
      "      Generated #{PackagesIndex.html(index.generated_at)}",
      '    </p>',
      '  </footer>',
      '</body>',
      '</html>',
      ''
    ]

    return Text.join(lines, "\n")
  end
end

program
  let args = Cli.args()
  let workers = PackagesIndex.worker_count(args)

  let positionals = []
  let index = 0
  while index < args.length
    if args[index] == '--workers'
      set index = index + 1
    else
      set positionals = [...positionals, args[index]]
    end
    set index = index + 1
  end

  if positionals.length > 1
    fail 'expected zero or one PACKAGES_DIR argument'
  end

  let packages_dir = './packages'
  if positionals.length == 1
    set packages_dir = positionals[0]
  end

  let generated_at = Env.default(
    'PACKAGES_INDEX_GENERATED_AT',
    Time.utc_iso8601()
  )

  PackagesIndex.generate(
    PackagesIndex.new(packages_dir, generated_at, workers)
  )
end
