# Scan a source text in memory and print the findings.
import '../../src/main.hey'

program
  let source = "fn admin?(supplied, expected)\n  if expected == ''\n    return false\n  end\n  return supplied == ('Basic ' + expected)\nend\n"
  for line in SecretLint.scan_text('Routes.hey', source)
    says line
  end
end
