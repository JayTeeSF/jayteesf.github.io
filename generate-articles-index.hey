#!/usr/bin/env hey

import 'stdlib:Cli'
import 'stdlib:Files'
import 'stdlib:Text'

module ArticlesIndex
  # Keep sort comparison local: Collections.compare in an O(n log n) comparator
  # can force repeated delegated stdlib work. Files.basename/read_text are kept
  # because they are already proven compiler-supported in the original script.
  private fn compare_text(left, right)
    if left < right
      return -1
    end
    if left > right
      return 1
    end
    return 0
  end

  private fn path_basename(path)
    return Files.basename(path)
  end

  fn new(articles_dir)
    return {
      articles_dir: articles_dir,
      output_path: Files.join(articles_dir, 'index.html')
    }
  end

  fn generate(index)
    ArticlesIndex.validate_articles_dir!(index)
    Files.write_text(index.output_path, ArticlesIndex.render_page(index))
    says "Generated #{index.output_path}"
  end

  private fn validate_articles_dir!(index)
    if Files.directory?(index.articles_dir)
      return
    end

    fail "Articles directory does not exist: #{index.articles_dir}"
  end

  # Find `open_marker` in `haystack`, then return everything up to (but not
  # including) the next `close_marker`. Returns '' if either marker is
  # missing — callers treat that as "meta not present".
  private fn find_between(haystack, open_marker, close_marker)
    let start_index = Text.find(haystack, open_marker)
    if start_index < 0
      return ''
    end

    let value_start = start_index + open_marker.length
    let remainder_length = haystack.length - value_start
    let remainder = Text.slice(haystack, value_start, remainder_length)

    let end_index = Text.find(remainder, close_marker)
    if end_index < 0
      return ''
    end

    return Text.slice(remainder, 0, end_index)
  end

  private fn meta_value(content, name)
    let marker = '<meta name="' + name + '" content="'
    return ArticlesIndex.find_between(content, marker, '"')
  end

  private fn extract_title(content)
    return ArticlesIndex.find_between(content, '<title>', '</title>')
  end

  private fn stem(filename)
    let suffix = '.html'
    if Text.ends_with?(filename, suffix)
      return Text.slice(filename, 0, filename.length - suffix.length)
    end
    return filename
  end

  # An index entry may legitimately differ from the page's own <title>: a
  # <title> is a browser tab and wants to be short, an index entry is a shelf
  # label and wants to be descriptive. Without these overrides that difference
  # had to be maintained BY HAND inside index.html, so running this generator
  # silently REWROTE entries someone had written deliberately -- which is why
  # people stopped running it and started hand-editing, which is how the index
  # and the pages drifted apart in the first place.
  #
  # article-index-title / article-index-desc WIN when present, so each page
  # carries its own index copy and this generator is IDEMPOTENT. Neither is
  # required: omit them and <title> / article-desc are used exactly as before.
  #
  # This mirrors generate-articles-index.rb, its Ruby twin. The two generators
  # disagreeing was itself the bug -- a fact restated in two programs, corrected
  # in one -- so any change here belongs in both. The dailies pair that once made
  # this a foursome was retired on 2026-08-29 along with the dailies category.
  #
  # NOTE: the checked-in articles/index.html is produced by the Ruby twin, which
  # is the one that can be run without a working Hey toolchain. This file is kept
  # in step by hand and has NOT been executed since the 2026-08-29 restructure.
  private fn parse_article(path)
    let content = Files.read_text(path)
    let filename = ArticlesIndex.path_basename(path)

    let title = ArticlesIndex.meta_value(content, 'article-index-title')
    if title == ''
      set title = ArticlesIndex.extract_title(content)
    end
    if title == ''
      set title = ArticlesIndex.stem(filename)
    end

    let date = ArticlesIndex.meta_value(content, 'article-date')
    let bucket = ArticlesIndex.meta_value(content, 'article-bucket')

    let desc = ArticlesIndex.meta_value(content, 'article-index-desc')
    if desc == ''
      set desc = ArticlesIndex.meta_value(content, 'article-desc')
    end

    let missing = []
    if date == ''
      set missing = [...missing, 'article-date']
    end
    if bucket == ''
      set missing = [...missing, 'article-bucket']
    end
    if desc == ''
      set missing = [...missing, 'article-desc']
    end

    if missing.length > 0
      fail filename + ': missing required meta tag(s): ' + Text.join(missing, ', ')
    end

    if not ArticlesIndex.known_bucket?(bucket)
      fail filename + ": unknown article-bucket '" + bucket + "' (expected one of " + ArticlesIndex.bucket_order_text() + ')'
    end

    let rank = ArticlesIndex.meta_value(content, 'article-index-rank')
    let ranked = rank
    if ranked == ''
      set ranked = ArticlesIndex.default_rank()
    end

    return {
      filename: filename,
      title: title,
      date: date,
      bucket: bucket,
      desc: desc,
      rank: ranked
    }
  end

  private fn article_files(articles_dir)
    # Files.files() is recursive. That made the article index walk articles/archive/
    # and then flatten those paths with basename(), which was both slow and wrong.
    # The index contract is the immediate contents of articles/.
    let candidates = Files.entries(articles_dir)
    let files = []

    for path in candidates
      let name = ArticlesIndex.path_basename(path)
      if Text.ends_with?(name, '.html') and name != 'index.html' and not Text.starts_with?(name, 'DRAFT-')
        set files = [...files, path]
      end
    end

    return files
  end

  private fn parse_all(articles_dir)
    let files = ArticlesIndex.article_files(articles_dir)
    let articles = []

    for path in files
      let article = ArticlesIndex.parse_article(path)
      set articles = [...articles, article]
    end

    return articles
  end

  # Stable order within a bucket: explicit rank first, then newest date first,
  # then filename ascending as a deterministic tie-break. The rank exists because
  # date order is wrong exactly where two pages shipped the same day and one is
  # the prerequisite for the other. It is compared as TEXT, so a page may simply
  # omit article-index-rank and take the default.
  private fn default_rank()
    return '50'
  end

  private fn compare_entries(left, right)
    let rank_cmp = ArticlesIndex.compare_text(left.rank, right.rank)
    if rank_cmp != 0
      return rank_cmp
    end

    let date_cmp = ArticlesIndex.compare_text(right.date, left.date)
    if date_cmp != 0
      return date_cmp
    end

    return ArticlesIndex.compare_text(left.filename, right.filename)
  end

  # THE SHELF LABELS ARE THE SITE'S INFORMATION ARCHITECTURE, not a record of an
  # internal publishing habit. The previous set -- featured / benchmarks / almost /
  # daily -- described a benchmark campaign and a daily working log the site no
  # longer runs, and two of its four sections rendered as 'No articles found.'
  # A reader does not care which internal lane produced a page; they care which
  # question it answers. These buckets are those questions, in reading order.
  private fn bucket_order()
    return ['start', 'how-it-works', 'build', 'actors', 'research', 'status', 'reference']
  end

  private fn bucket_order_text()
    return Text.join(ArticlesIndex.bucket_order(), ', ')
  end

  private fn known_bucket?(bucket)
    for name in ArticlesIndex.bucket_order()
      if name == bucket
        return true
      end
    end
    return false
  end

  private fn entries_in_bucket(articles, bucket)
    let picked = []

    for article in articles
      if article.bucket == bucket
        set picked = [...picked, article]
      end
    end

    return picked.sort(ArticlesIndex.compare_entries)
  end

  private fn article_item_lines(article)
    return [
      '    <li>',
      %qq(      <a href="#{article.filename}">#{article.title}</a>),
      %qq(      <p class="desc">#{article.desc}</p>),
      %qq(      <span class="date">#{article.date}</span>),
      '    </li>'
    ]
  end

  private fn bucket_heading(bucket)
    if bucket == 'start'
      return 'Start here'
    end
    if bucket == 'how-it-works'
      return 'How Hey works'
    end
    if bucket == 'build'
      return 'Build with Hey'
    end
    if bucket == 'actors'
      return 'Actors'
    end
    if bucket == 'research'
      return 'Ideas and research'
    end
    if bucket == 'status'
      return 'Current project status'
    end
    return 'Reference'
  end

  # AN EMPTY BUCKET RENDERS NOTHING AT ALL. The old generator emitted the heading
  # plus 'No articles found.', which is how the published index came to advertise
  # two sections -- Benchmark stories, Daily reports -- that had no contents and no
  # prospect of any. A shelf label with nothing on it is not information; it is the
  # residue of a workflow.
  private fn bucket_section_lines(bucket, entries)
    if entries.empty?
      return []
    end

    let heading = ArticlesIndex.bucket_heading(bucket)
    let lines = ['  <h2>' + heading + '</h2>', '  <ul class="articles">']

    for article in entries
      let item_lines = ArticlesIndex.article_item_lines(article)
      for line in item_lines
        set lines = [...lines, line]
      end
    end

    return [...lines, '  </ul>']
  end

  private fn render_page(index)
    let articles = ArticlesIndex.parse_all(index.articles_dir)
    let sections = []

    for bucket in ArticlesIndex.bucket_order()
      let entries = ArticlesIndex.entries_in_bucket(articles, bucket)
      let section_lines = ArticlesIndex.bucket_section_lines(bucket, entries)

      if not section_lines.empty?
        set sections = [...sections, '']

        for line in section_lines
          set sections = [...sections, line]
        end
      end
    end

    let lines = [
      '<!DOCTYPE html>',
      '<html lang="en">',
      '<head>',
      '<meta charset="utf-8">',
      '<meta name="viewport" content="width=device-width, initial-scale=1">',
      '<title>Articles — JayTeeSF</title>',
      '<style>',
      '  :root {',
      '    --bg: #fcfcfb; --ink: #0b0b0b; --muted: #52514e;',
      '    --border: #e1e0d9; --accent: #2a78d6;',
      '  }',
      '  @media (prefers-color-scheme: dark) {',
      '    :root { --bg: #1a1a19; --ink: #ffffff; --muted: #c3c2b7;',
      '            --border: #2c2c2a; --accent: #3987e5; }',
      '  }',
      '  :root[data-theme="dark"] { --bg: #1a1a19; --ink: #ffffff; --muted: #c3c2b7;',
      '            --border: #2c2c2a; --accent: #3987e5; }',
      '  :root[data-theme="light"] { --bg: #fcfcfb; --ink: #0b0b0b; --muted: #52514e;',
      '            --border: #e1e0d9; --accent: #2a78d6; }',
      '  * { box-sizing: border-box; }',
      '  body {',
      '    margin: 0; background: var(--bg); color: var(--ink);',
      '    font: 17px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,',
      '          Helvetica, Arial, sans-serif;',
      '  }',
      '  main { max-width: 46rem; margin: 0 auto; padding: 3rem 1.25rem 4rem; }',
      '  h1 { font-size: 1.9rem; line-height: 1.2; margin: 0 0 0.4rem; }',
      '  .sub { color: var(--muted); margin: 0 0 2.5rem; }',
      '  h2 {',
      '    font-size: 1.05rem; text-transform: uppercase; letter-spacing: 0.06em;',
      '    color: var(--muted); border-bottom: 1px solid var(--border);',
      '    padding-bottom: 0.4rem; margin: 2.5rem 0 1rem;',
      '  }',
      '  ul.articles { list-style: none; margin: 0; padding: 0; }',
      '  ul.articles li { margin: 0 0 1.4rem; }',
      '  ul.articles a {',
      '    color: var(--accent); text-decoration: none; font-weight: 600;',
      '    font-size: 1.12rem;',
      '  }',
      '  ul.articles a:hover { text-decoration: underline; }',
      '  .desc { color: var(--muted); margin: 0.15rem 0 0; }',
      '  .date { font-size: 0.85rem; color: var(--muted); }',
      '  .home { display: inline-block; margin-bottom: 2rem; color: var(--muted);',
      '          text-decoration: none; font-size: 0.9rem; }',
      '  .home:hover { color: var(--accent); }',
      '</style>',
      '</head>',
      '<body>',
      '<main>',
      '  <a class="home" href="../index.html">&larr; www.jayteesf.com</a>',
      '  <h1>Articles</h1>',
      '  <p class="sub">Essays, guides, research and current reference material from',
      '  building the Hey programming language — how the language works, how its',
      '  compiler is being made trustworthy and fast, and what its actor and',
      '  distributed systems are trying to become.</p>',
      ...sections,
      '</main>',
      '</body>',
      '</html>',
      ''
    ]

    return Text.join(lines, "\n")
  end
end

fn usage()
  says 'usage: generate-articles-index [ARTICLES_DIR]'
  says ''
  says 'Regenerates ARTICLES_DIR/index.html from the article-date,'
  says 'article-bucket and article-desc meta tags of the articles in'
  says 'that directory. Default ARTICLES_DIR: ./articles'
  says ''
  says '  -h, --help   show this help and exit'
  return 0
end

program
  let args = Cli.args()
  let articles_dir = './articles'
  let run = 1

  if args.length == 1
    let first = args[0]
    if first == '--help'
      let u1 = usage()
      set run = 0
    else
      if first == '-h'
        let u2 = usage()
        set run = 0
      else
        if Text.starts_with?(first, '-')
          let u3 = usage()
          fail 'unknown option: ' + first
        else
          set articles_dir = first
        end
      end
    end
  end

  if args.length > 1
    let u4 = usage()
    fail 'expected zero or one ARTICLES_DIR argument'
  end

  if run == 1
    ArticlesIndex.generate(ArticlesIndex.new(articles_dir))
  end
end

