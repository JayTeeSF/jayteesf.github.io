# Pure documentation example (no library load required).
import '../../main.hey'

program
  says HeyJose.version()
  # A verification policy pins the permitted algorithms; alg=none is never in it.
  let policy = Jose.default_policy()
  says len(policy.algorithms)
  says Jose.audience_ok?(['mmeoww-api'], 'mmeoww-api')
end
